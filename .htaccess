<Files "config.php">
    Require all denied
</Files>
<Files "config.example.php">
    Require all denied
</Files>

RewriteEngine On

# /index.php -> / (not /index)
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# /some-page.php -> /some-page (visible redirect, so .php never shows in the URL bar)
# Never redirect anything under /api/ — those are POST endpoints, and a 301
# silently turns a POST into a GET, breaking the request (caught 2026-08-23).
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteCond %1 !^api/ [NC]
RewriteRule ^ /%1 [R=301,L]

# /some-page -> some-page.php (internal only, invisible to the visitor)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^.]+)$ $1.php [NC,L]
